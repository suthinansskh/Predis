# ==========================================
# Predis Tools — Configuration
# ==========================================
# Copy this file to .env and fill in actual values (never commit .env)

# Google Sheets (service account must have Editor access to the spreadsheet)
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
SHEET_DRUGS=Drug_List

# MySQL (HOSxP) — use a read-only account
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
